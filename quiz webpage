<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Advanced Quiz Master</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #ffffff;
            --accent: #ff477e;
            --success: #2ec4b6;
            --danger: #e71d36;
            --bg-glass: rgba(255, 255, 255, 0.1);
            --border-glass: rgba(255, 255, 255, 0.2);
            --text-main: #ffffff;
            --text-muted: rgba(255, 255, 255, 0.7);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(-45deg, #1A1A2E, #16213E, #0F3460, #E94560);
            background-size: 400% 400%;
            animation: gradientBG 15s ease infinite;
            color: var(--text-main);
            overflow: hidden;
        }

        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        #app {
            width: 90%;
            max-width: 650px;
            background: var(--bg-glass);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--border-glass);
            border-radius: 24px;
            box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
            padding: 40px;
            position: relative;
            z-index: 10;
        }

        .screen {
            display: none;
            opacity: 0;
            transition: opacity 0.5s ease;
        }

        .screen.active {
            display: flex;
            flex-direction: column;
            opacity: 1;
            animation: fadeIn 0.5s ease forwards;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        h1, h2, h3 {
            font-family: 'Outfit', sans-serif;
            font-weight: 800;
        }

        /* --- Custom UI Components --- */
        .header {
            text-align: center;
            margin-bottom: 30px;
        }

        .header h1 {
            font-size: 2.5rem;
            margin-bottom: 10px;
            background: linear-gradient(90deg, #fff, #f0f0f0);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .header p {
            color: var(--text-muted);
        }

        /* Buttons */
        .btn {
            background: rgba(255, 255, 255, 0.15);
            border: 1px solid var(--border-glass);
            color: var(--text-main);
            padding: 16px 24px;
            font-size: 1.1rem;
            font-family: 'Inter', sans-serif;
            font-weight: 500;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            width: 100%;
            margin-bottom: 15px;
            position: relative;
            overflow: hidden;
        }

        .btn:hover {
            background: rgba(255, 255, 255, 0.25);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.2);
        }

        .btn:active {
            transform: translateY(1px);
        }

        .btn.category {
            font-family: 'Outfit', sans-serif;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .btn.primary {
            background: linear-gradient(135deg, #ff477e, #e94560);
            border: none;
            font-weight: 600;
            box-shadow: 0 4px 15px rgba(233, 69, 96, 0.4);
        }

        .btn.primary:hover {
            box-shadow: 0 6px 20px rgba(233, 69, 96, 0.6);
        }

        .btn.correct {
            background: var(--success);
            border-color: var(--success);
            color: #fff;
        }

        .btn.wrong {
            background: var(--danger);
            border-color: var(--danger);
            color: #fff;
        }

        /* Quiz Header (Timer, Score) */
        .quiz-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            font-size: 1.1rem;
            font-weight: 600;
            background: rgba(0,0,0,0.2);
            padding: 15px;
            border-radius: 16px;
        }

        .timer {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .timer-circle {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: 3px solid var(--accent);
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Outfit', sans-serif;
            font-weight: 800;
            color: var(--accent);
        }

        .timer-warning {
            border-color: var(--danger);
            color: var(--danger);
            animation: pulseWarning 1s infinite;
        }

        @keyframes pulseWarning {
            0% { transform: scale(1); }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); }
        }

        /* Progress Bar */
        .progress-container {
            width: 100%;
            height: 8px;
            background: rgba(255,255,255,0.1);
            border-radius: 10px;
            margin-bottom: 30px;
            overflow: hidden;
        }

        .progress-bar {
            height: 100%;
            background: var(--accent);
            width: 0%;
            transition: width 0.4s ease;
            box-shadow: 0 0 10px var(--accent);
        }

        /* Question Text */
        .question-wrapper {
            margin-bottom: 30px;
            min-height: 100px;
            display: flex;
            align-items: center;
        }

        .question-text {
            font-size: 1.5rem;
            font-weight: 600;
            line-height: 1.4;
            font-family: 'Outfit', sans-serif;
        }

        .options-wrapper {
            display: grid;
            grid-template-columns: 1fr;
            gap: 15px;
        }

        @media(min-width: 600px) {
            .options-wrapper {
                grid-template-columns: 1fr 1fr;
            }
        }

        /* Result Screen */
        .result-content {
            text-align: center;
            padding: 20px 0;
        }

        .score-circle {
            width: 150px;
            height: 150px;
            margin: 0 auto 20px;
            border-radius: 50%;
            background: conic-gradient(var(--success) 0%, rgba(255,255,255,0.1) 0%);
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
        }

        .score-circle::before {
            content: '';
            position: absolute;
            width: 130px;
            height: 130px;
            background: #16213E; /* matching mid background roughly */
            border-radius: 50%;
        }

        .score-circle-text {
            position: relative;
            z-index: 1;
            font-family: 'Outfit', sans-serif;
        }

        .score-circle-text h2 {
            font-size: 2.5rem;
            margin: 0;
        }

        .performance-msg {
            font-size: 1.5rem;
            margin-bottom: 20px;
            color: var(--accent);
            font-weight: 600;
        }

        .high-score {
            font-size: 1.1rem;
            color: var(--text-muted);
            margin-bottom: 30px;
        }

        /* Floating particles */
        .particles {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none;
            z-index: 1;
        }

        .particle {
            position: absolute;
            background: rgba(255,255,255,0.2);
            border-radius: 50%;
            animation: float 20s infinite linear;
        }

        @keyframes float {
            0% { transform: translateY(100vh) scale(0); opacity: 0; }
            10% { opacity: 1; }
            90% { opacity: 1; }
            100% { transform: translateY(-10vh) scale(1.5); opacity: 0; }
        }

    </style>
</head>
<body>

    <div class="particles" id="particles"></div>

    <div id="app">
        <!-- Start Screen -->
        <div id="start-screen" class="screen active">
            <div class="header">
                <h1>Quiz Master</h1>
                <p>Test your knowledge across multiple domains</p>
            </div>
            
            <h3 style="margin-bottom: 15px; font-weight: 500;">Select a Category:</h3>
            <div class="category-list">
                <button class="btn category" onclick="startQuiz('Math')">🧮 Mathematics</button>
                <button class="btn category" onclick="startQuiz('Science')">🔬 Science</button>
                <button class="btn category" onclick="startQuiz('Programming')">💻 Programming</button>
                <button class="btn category" onclick="startQuiz('General')">🌍 General Knowledge</button>
            </div>
        </div>

        <!-- Quiz Screen -->
        <div id="quiz-screen" class="screen">
            <div class="quiz-top">
                <div class="score-display">Score: <span id="score">0</span></div>
                <div class="timer">
                    <span style="font-size: 0.9em; color: var(--text-muted)">Time</span>
                    <div class="timer-circle" id="timer">15</div>
                </div>
            </div>
            
            <div class="progress-container">
                <div class="progress-bar" id="progress-bar"></div>
            </div>

            <div style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 10px;" id="question-tracker">Question 1 of 5</div>
            
            <div class="question-wrapper">
                <div class="question-text" id="question-text">Question goes here?</div>
            </div>

            <div class="options-wrapper" id="options-container">
                <!-- Options injected via JS -->
            </div>
        </div>

        <!-- Result Screen -->
        <div id="result-screen" class="screen">
            <div class="header">
                <h1>Quiz Complete!</h1>
            </div>
            
            <div class="result-content">
                <div class="score-circle" id="score-circle-element">
                    <div class="score-circle-text">
                        <h2 id="final-score">0</h2>
                        <span style="font-size: 0.9em; color: var(--text-muted)">Points</span>
                    </div>
                </div>
                
                <div class="performance-msg" id="performance-msg">Great Job!</div>
                <div class="high-score" id="high-score-display">High Score: 0</div>
                
                <button class="btn primary" onclick="resetQuiz()">Play Again</button>
                <button class="btn" onclick="goToMenu()">Main Menu</button>
            </div>
        </div>
    </div>

    <script>
        // --- Data ---
        const quizData = {
            Math: [
                { q: "What is 15 * 12?", opt: ["180", "150", "200", "160"], a: "180" },
                { q: "Solve: 8 + 4 * 2", opt: ["24", "16", "20", "18"], a: "16" },
                { q: "What is the square root of 144?", opt: ["10", "12", "14", "16"], a: "12" },
                { q: "If 3x = 18, what is x?", opt: ["5", "6", "7", "8"], a: "6" },
                { q: "What is the next prime number after 7?", opt: ["9", "10", "11", "13"], a: "11" }
            ],
            Science: [
                { q: "What planet is known as the Red Planet?", opt: ["Earth", "Mars", "Jupiter", "Venus"], a: "Mars" },
                { q: "What is the chemical symbol for Gold?", opt: ["Au", "Ag", "Pb", "Fe"], a: "Au" },
                { q: "What gas do plants absorb?", opt: ["Oxygen", "Carbon Dioxide", "Nitrogen", "Hydrogen"], a: "Carbon Dioxide" },
                { q: "What is the hardest natural substance on Earth?", opt: ["Gold", "Iron", "Diamond", "Platinum"], a: "Diamond" },
                { q: "How many bones are in the adult human body?", opt: ["206", "205", "208", "210"], a: "206" }
            ],
            Programming: [
                { q: "Which language primarily runs in a web browser?", opt: ["Java", "C++", "Python", "JavaScript"], a: "JavaScript" },
                { q: "What does CSS stand for?", opt: ["Central Style Sheets", "Cascading Style Sheets", "Cascading Simple Sheets", "None"], a: "Cascading Style Sheets" },
                { q: "What year was JavaScript launched?", opt: ["1996", "1995", "1994", "1993"], a: "1995" },
                { q: "What is the symbol for strict equality in JS?", opt: ["==", "=", "===", "!=="], a: "===" },
                { q: "Which is a JS framework?", opt: ["Laravel", "Django", "React", "Flask"], a: "React" }
            ],
            General: [
                { q: "What is the capital of Japan?", opt: ["Seoul", "Beijing", "Tokyo", "Kyoto"], a: "Tokyo" },
                { q: "Who painted the Mona Lisa?", opt: ["Van Gogh", "Da Vinci", "Picasso", "Rembrandt"], a: "Da Vinci" },
                { q: "What is the largest ocean on Earth?", opt: ["Atlantic", "Pacific", "Indian", "Arctic"], a: "Pacific" },
                { q: "In what year did the Titanic sink?", opt: ["1910", "1912", "1914", "1916"], a: "1912" },
                { q: "Which element has the atomic number 1?", opt: ["Helium", "Oxygen", "Carbon", "Hydrogen"], a: "Hydrogen" }
            ]
        };

        // --- State ---
        let currentCategory = '';
        let questions = [];
        let currentQuestionIndex = 0;
        let score = 0;
        let timeLeft = 15;
        let timerInterval;
        let isAnswered = false;

        // --- DOM Elements ---
        const startScreen = document.getElementById('start-screen');
        const quizScreen = document.getElementById('quiz-screen');
        const resultScreen = document.getElementById('result-screen');
        
        const questionText = document.getElementById('question-text');
        const optionsContainer = document.getElementById('options-container');
        const timerElement = document.getElementById('timer');
        const scoreElement = document.getElementById('score');
        const progressBar = document.getElementById('progress-bar');
        const questionTracker = document.getElementById('question-tracker');

        const finalScoreElement = document.getElementById('final-score');
        const performanceMsgElement = document.getElementById('performance-msg');
        const highScoreElement = document.getElementById('high-score-display');
        const scoreCircleElement = document.getElementById('score-circle-element');

        // --- Web Audio API for Sounds ---
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        
        function playSound(type) {
            if(audioCtx.state === 'suspended') audioCtx.resume();
            const oscillator = audioCtx.createOscillator();
            const gainNode = audioCtx.createGain();
            
            oscillator.connect(gainNode);
            gainNode.connect(audioCtx.destination);
            
            if (type === 'correct') {
                oscillator.type = 'sine';
                oscillator.frequency.setValueAtTime(600, audioCtx.currentTime);
                oscillator.frequency.exponentialRampToValueAtTime(1200, audioCtx.currentTime + 0.1);
                gainNode.gain.setValueAtTime(0.3, audioCtx.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
                oscillator.start();
                oscillator.stop(audioCtx.currentTime + 0.3);
            } else if (type === 'wrong') {
                oscillator.type = 'sawtooth';
                oscillator.frequency.setValueAtTime(300, audioCtx.currentTime);
                oscillator.frequency.exponentialRampToValueAtTime(100, audioCtx.currentTime + 0.2);
                gainNode.gain.setValueAtTime(0.3, audioCtx.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
                oscillator.start();
                oscillator.stop(audioCtx.currentTime + 0.3);
            } else if (type === 'tick') {
                oscillator.type = 'triangle';
                oscillator.frequency.setValueAtTime(800, audioCtx.currentTime);
                gainNode.gain.setValueAtTime(0.1, audioCtx.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.05);
                oscillator.start();
                oscillator.stop(audioCtx.currentTime + 0.05);
            }
        }

        // --- Logic ---

        function startQuiz(category) {
            if(audioCtx.state === 'suspended') audioCtx.resume(); // Ensure audio unlocks on first click
            
            currentCategory = category;
            // clone and shuffle
            questions = [...quizData[category]].sort(() => Math.random() - 0.5);
            currentQuestionIndex = 0;
            score = 0;
            
            startScreen.classList.remove('active');
            quizScreen.classList.add('active');
            
            updateScoreUI();
            loadQuestion();
        }

        function loadQuestion() {
            isAnswered = false;
            clearInterval(timerInterval);
            timeLeft = 15;
            timerElement.textContent = timeLeft;
            timerElement.classList.remove('timer-warning');

            const q = questions[currentQuestionIndex];
            questionText.textContent = q.q;
            questionTracker.textContent = `Question ${currentQuestionIndex + 1} of ${questions.length}`;
            
            // update progress
            const progressPercent = ((currentQuestionIndex) / questions.length) * 100;
            progressBar.style.width = `${progressPercent}%`;

            // Mix options
            const opts = [...q.opt].sort(() => Math.random() - 0.5);
            optionsContainer.innerHTML = '';
            
            opts.forEach(opt => {
                const btn = document.createElement('button');
                btn.className = 'btn';
                btn.textContent = opt;
                btn.onclick = () => selectAnswer(btn, opt, q.a);
                optionsContainer.appendChild(btn);
            });

            startTimer();
        }

        function startTimer() {
            timerInterval = setInterval(() => {
                timeLeft--;
                timerElement.textContent = timeLeft;
                
                if (timeLeft <= 5 && timeLeft > 0) {
                    timerElement.classList.add('timer-warning');
                    playSound('tick');
                }

                if (timeLeft <= 0) {
                    clearInterval(timerInterval);
                    timerElement.textContent = "0";
                    playSound('wrong');
                    handleTimeOut();
                }
            }, 1000);
        }

        function selectAnswer(btnElement, selectedOpt, correctOpt) {
            if (isAnswered) return;
            isAnswered = true;
            clearInterval(timerInterval);

            const allBtns = optionsContainer.querySelectorAll('.btn');
            
            if (selectedOpt === correctOpt) {
                btnElement.classList.add('correct');
                score += 10 + timeLeft; // Bonus for time
                updateScoreUI();
                playSound('correct');
            } else {
                btnElement.classList.add('wrong');
                playSound('wrong');
            }

            // Highlight correct one anyway
            allBtns.forEach(b => {
                b.disabled = true; // disable clicks
                if (b.textContent === correctOpt) {
                    b.classList.add('correct');
                } else if (b !== btnElement) {
                    b.style.opacity = '0.5';
                }
            });

            setTimeout(() => {
                nextQuestion();
            }, 1500);
        }

        function handleTimeOut() {
            isAnswered = true;
            const q = questions[currentQuestionIndex];
            const allBtns = optionsContainer.querySelectorAll('.btn');
            
            allBtns.forEach(b => {
                b.disabled = true;
                if (b.textContent === q.a) {
                    b.classList.add('correct');
                } else {
                    b.style.opacity = '0.5';
                }
            });

            setTimeout(() => {
                nextQuestion();
            }, 1500);
        }

        function nextQuestion() {
            currentQuestionIndex++;
            if (currentQuestionIndex < questions.length) {
                loadQuestion();
            } else {
                showResults();
            }
        }

        function updateScoreUI() {
            scoreElement.textContent = score;
        }

        function showResults() {
            quizScreen.classList.remove('active');
            resultScreen.classList.add('active');
            
            finalScoreElement.textContent = score;

            // Performance message
            const maxScore = questions.length * 25; // roughly 10 points + max 15 time bonus
            const percentage = score / maxScore;
            
            if (percentage > 0.8) {
                performanceMsgElement.textContent = "Excellent! 🏆";
                performanceMsgElement.style.color = "var(--success)";
            } else if (percentage > 0.5) {
                performanceMsgElement.textContent = "Good Job! 👍";
                performanceMsgElement.style.color = "#FFD166"; // Yellowish
            } else {
                performanceMsgElement.textContent = "Needs Improvement! 📚";
                performanceMsgElement.style.color = "var(--danger)";
            }

            // Progress circle animation calculation
            progressBar.style.width = '100%'; // max out the bar from quiz screen
            
            const pDeg = Math.round(percentage * 360);
            scoreCircleElement.style.background = `conic-gradient(var(--success) ${pDeg}deg, rgba(255,255,255,0.1) ${pDeg}deg)`;

            // LocalStorage High Score
            const hsKey = `quiz_hs_${currentCategory}`;
            let highScore = localStorage.getItem(hsKey) || 0;
            if (score > highScore) {
                highScore = score;
                localStorage.setItem(hsKey, highScore);
                highScoreElement.textContent = `New High Score! 🌟 (${highScore})`;
                highScoreElement.style.color = "var(--success)";
            } else {
                highScoreElement.textContent = `High Score: ${highScore}`;
                highScoreElement.style.color = "var(--text-muted)";
            }
        }

        function resetQuiz() {
            resultScreen.classList.remove('active');
            startQuiz(currentCategory);
        }

        function goToMenu() {
            resultScreen.classList.remove('active');
            startScreen.classList.add('active');
        }

        // --- Background Particles ---
        function createParticles() {
            const container = document.getElementById('particles');
            for(let i=0; i<30; i++) {
                const p = document.createElement('div');
                p.className = 'particle';
                const size = Math.random() * 8 + 2;
                p.style.width = size + 'px';
                p.style.height = size + 'px';
                p.style.left = Math.random() * 100 + 'vw';
                p.style.animationDuration = (Math.random() * 15 + 10) + 's';
                p.style.animationDelay = Math.random() * 10 + 's';
                container.appendChild(p);
            }
        }
        
        // initialize
        createParticles();

    </script>
</body>
</html>
